{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on Monday"],
  "customManagers": [
    {
      "description": "Update GOOSE_VERSION ARG in backend/Dockerfile",
      "customType": "regex",
      "fileMatch": ["^backend/Dockerfile$"],
      "matchStrings": ["ARG GOOSE_VERSION=(?<currentValue>v[\\d.]+)"],
      "depNameTemplate": "github.com/pressly/goose/v3",
      "datasourceTemplate": "go"
    }
  ],
  "packageRules": [
    {
      "description": "Group Go minor/patch updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Go dependencies"
    },
    {
      "description": "Group frontend minor/patch updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Frontend dependencies"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
